# 1. Core FastAPI & App Settings
APP_NAME="RetailIQ"
ENV="development"
DEBUG=False

# 2. Security & Authentication
# Note: You can generate a truly random secure key by running `openssl rand -hex 32` in your terminal.
SECRET_KEY= "adding_your_Secreat_key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# 3. Database Configurations
# Default local SQLite file matching your project layout
DATABASE_URL="sqlite:///./retailiq.db"

# 4. Third-Party AI / LLM Configurations (For RAG Assistant & Report Generator)
# Replace these with your actual API credentials when ready
GROQ_API_KEY=gsk_your_groq_api_key
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_MODEL=openai/gpt-oss-20b
HF_TOKEN=hf_huggingface_token
# 5. File Upload Configurations (For Shelf Monitoring & Reports)
UPLOAD_DIR="storage/uploads"
DETECTED_DIR="storage/detected_images"